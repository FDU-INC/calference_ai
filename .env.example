# Calference 环境变量配置示例

# ============================================================================
# LLM API 配置（必需）
# ============================================================================

# 使用智谱 GLM-4V（推荐）
LLM_MODEL_NAME=glm-4v-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_api_key_here

# 或使用 Claude（备选）
# LLM_MODEL_NAME=claude-3-7-sonnet-20250219
# LLM_BASE_URL=http://your-proxy:8000
# LLM_API_KEY=your_api_key_here

# ============================================================================
# 代理配置（可选，如需要）
# ============================================================================

# HTTP 代理
# HTTP_PROXY=http://proxy.example.com:7897
# HTTPS_PROXY=http://proxy.example.com:7897

# ============================================================================
# HuggingFace 配置（可选，用于加速模型下载）
# ============================================================================

# 使用 HuggingFace 镜像
# HF_ENDPOINT=https://hf-mirror.com

# ============================================================================
# 项目配置（可选，通常在 config.py 中配置）
# ============================================================================

# RAG 配置
# RAG_TOP_K=3
# RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 输出目录
# OUTPUT_REPORT_DIR=output_reports

# ============================================================================
# 使用说明
# ============================================================================
#
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 编辑 .env 文件，填入你的 API 密钥
#    nano .env
#
# 3. 加载环境变量
#    source .env
#
# 或直接设置环境变量：
#    export LLM_API_KEY="your_api_key_here"
#
# ============================================================================
